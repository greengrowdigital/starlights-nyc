# ---------------------------------------------------------------------------
# Cal.com — SERVER SIDE ONLY
#
# No VITE_ prefix on any of these, on purpose. Vite inlines every VITE_*
# variable into the public JavaScript bundle, so a key named VITE_CAL_API_KEY
# would be readable by anyone who opens the deployed site. These are read only
# by the serverless functions in /api.
#
# Set the same four in Vercel: Settings -> Environment Variables.
# ---------------------------------------------------------------------------

# From cal.com -> Settings -> Developer -> API keys.
CAL_API_KEY=

# The event type customers book. Find it in the URL of the event type in Cal,
# or with: GET https://api.cal.com/v2/event-types (header cal-api-version: 2024-06-14)
CAL_EVENT_TYPE_ID=

# The shop's clock. Slot labels are formatted in this zone so every visitor
# sees the time they will actually drive there, not their own local time.
CAL_TIMEZONE=America/New_York

# Cal requires an attendee email. Our form does not, because this shop works by
# phone — when a customer leaves it blank, the booking is filed under this
# address and their real phone number goes in the booking notes.
CAL_FALLBACK_EMAIL=nycstarlights@gmail.com

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# An extra webhook (n8n, Zapier, Formspree...). Only tried if the Cal booking
# could not be made. Leave unset and the site still works: the confirmation
# screen hands the customer a one-tap SMS / email carrying the same summary.
VITE_BOOKING_ENDPOINT=

# Only read when BOOKING.mode === 'calcom' in src/config.js, which swaps the
# date/time step for the Cal embed. Format: "user/event-slug"
VITE_CALCOM_LINK=
